{
  "name": "reponecromancer",
  "version": "0.1.0",
  "private": true,
  "description": "Raise dead open-source repos: audit dead dependencies, plan upgrades, patch breaking changes with AST codemods, generate regression tests, verify green.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test engine/engine.test.ts",
    "typecheck": "tsc --noEmit",
    "necro": "tsx cli/necro.ts",
    "necro:verify": "tsx scripts/verify-presets.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.1.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "magic-string": "^1.4.5",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/types": "^8.1.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenkhangph/reponecromancer.git"
  },
  "keywords": [
    "kiro",
    "kiroween",
    "codemod",
    "legacy",
    "migration",
    "resurrection"
  ]
}
