{
  "enabled": true,
  "name": "Engine tests on save",
  "description": "Whenever an engine source file is saved, run the engine unit tests and fix any regression before continuing.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["engine/**/*.ts"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "An engine file was just edited. Run `npm test` and `npm run typecheck`. If anything fails, explain the root cause in one sentence and fix it in the engine (never by weakening the test). Follow the steering in codemods.md."
  }
}
