{
  "enabled": true,
  "name": "Draft Devpost section",
  "description": "Manual hook: regenerate the 'How we used Kiro' section of DEVPOST.md from the current .kiro folder.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Read every file under .kiro/ and update the 'How we built it with Kiro' section of DEVPOST.md: list each spec with what it drove, each steering file and what it constrained, each hook with a concrete moment it fired, and how the MCP servers were used. Keep it factual and concise."
  }
}
